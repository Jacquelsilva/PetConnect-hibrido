# ==========================================
# PETCONNECT MOBILE - VARIÁVEIS DE AMBIENTE
# ==========================================

# URL base da API REST do PetConnect (obrigatória para autenticação online e integração)
EXPO_PUBLIC_API_URL=https://api.petconnect.com.br

# Google Client ID para autenticação via Google OAuth (Expo AuthSession)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=seu_app_id